# ====================================================
# VANIKA COGNITIVE CARE — PRODUCTION ENV TEMPLATE
# ====================================================

# ── BACKEND SERVER CONFIGURATION ──
PORT=5000
NODE_ENV="production"
CLIENT_URL="https://your-app-domain.vercel.app"

# ── DATABASE CONFIGURATION (Supabase / PostgreSQL) ──
DATABASE_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?pgbouncer=true&schema=public"
DIRECT_URL="postgresql://postgres:[PASSWORD]@[HOST]:5432/postgres?schema=public"

# ── SECURITY & JWT ──
JWT_SECRET="YOUR_RANDOM_LONG_PRODUCTION_JWT_SECRET_KEY"

# ── SERVER-SIDE AI INTEGRATION (GEMINI) ──
# IMPORTANT: Keep server-side ONLY. Never expose in frontend build!
GEMINI_API_KEY="YOUR_GEMINI_API_KEY_HERE"

# ── FRONTEND PUBLIC CONFIGURATION ──
# (Included in frontend Vercel/Vite build. Must start with VITE_)
VITE_API_BASE_URL="https://your-api-domain.onrender.com/api"
